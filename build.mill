object frontend extends Cross[Frontend](SpinalVersion.compilers) {
  def defaultCrossSegments = Seq(SpinalVersion.compilers.head)
}
trait Frontend extends SpinalModule {
  def moduleDeps = Seq(paramrtl(crossScalaVersion), core(crossScalaVersion), morphruntime(crossScalaVersion), lib(crossScalaVersion))
  override def scalacOptions = super.scalacOptions() ++ modulePluginOptions()
  def mvnDeps = super.mvnDeps() ++ Seq(mvn"com.lihaoyi::sourcecode:0.3.0")
