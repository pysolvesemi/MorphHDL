-name: Increment 34 source export
-
-on:
-  push:
-    branches:
-      - agent/increment-34-generic-processes
-  workflow_dispatch:
-
-permissions:
-  contents: read
-
-concurrency:
-  group: increment-34-source-export-${{ github.ref }}
-  cancel-in-progress: true
-
-jobs:
-  export:
-    runs-on: ubuntu-latest
-    timeout-minutes: 15
-    steps:
-      - name: Check out Increment 34 branch
-        uses: actions/checkout@v4
-        with:
-          fetch-depth: 0
-          submodules: false
-
-      - name: Package head and target branch source trees
-        shell: bash
-        run: |
-          set -euo pipefail
-          git archive --format=tar.gz \
-            --output=/tmp/morphhdl-increment-34-head.tar.gz \
-            HEAD
-          git archive --format=tar.gz \
-            --output=/tmp/morphhdl-increment-34-base.tar.gz \
-            origin/parameterized-verilog
-          sha256sum \
-            /tmp/morphhdl-increment-34-head.tar.gz \
-            /tmp/morphhdl-increment-34-base.tar.gz
-
-      - name: Upload source archives
-        uses: actions/upload-artifact@v4
-        with:
-          name: morphhdl-increment-34-sources-${{ github.sha }}
-          path: |
-            /tmp/morphhdl-increment-34-head.tar.gz
-            /tmp/morphhdl-increment-34-base.tar.gz
-          if-no-files-found: error
-          retention-days: 3
