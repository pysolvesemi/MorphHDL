diff --git a/morphhdl/src/test/scala/morphhdl/SignednessCompatibilityTests.scala b/morphhdl/src/test/scala/morphhdl/SignednessCompatibilityTests.scala
index 28776268c..7eb92835b 100644
--- a/morphhdl/src/test/scala/morphhdl/SignednessCompatibilityTests.scala
