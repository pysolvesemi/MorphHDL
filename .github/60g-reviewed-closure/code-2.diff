+  test("60g signed resize ownership remains exact under default publication") {
+    directory { root =>
+      final class OwnedResize(width: HdlInt) extends Component {
+        setDefinitionName("DefaultOwnedSignedResize")
+        val source = in(SInt(width bits))
+        val foreign = in(SInt(width bits))
+        val resized = source.resize(8).setName("resized")
+        val observed = out(SInt(8 bits))
+        val foreignObserved = out(SInt(width bits))
+        observed := resized
+        foreignObserved := foreign
+      }
+      var dut: OwnedResize = null
+      var checked = false
+      val config = fresh(root.resolve("owned.v"))
+      config.phasesInserters += MorphHdlSignednessAnalysis.install { snapshot =>
+        val operation = dut.resized.head.source.asInstanceOf[ResizeSInt]
+        val evidence = snapshot.castOperand(operation, 0)
+        assert(ExternalParameterizedNativeResize.ownsSignedResize(operation))
+        val clone = new ResizeSInt
+        clone.input = dut.source
+        clone.size = operation.size
+        assert(!ExternalParameterizedNativeResize.ownsSignedResize(clone))
+        operation.input = dut.foreign
+        assert(!ExternalParameterizedNativeResize.ownsSignedResize(operation))
+        intercept[MorphHdlSignednessException] {
+          snapshot.validateCastOperand(operation, 0, evidence)
+        }
+        operation.input = dut.source
+        assert(ExternalParameterizedNativeResize.ownsSignedResize(operation))
+        snapshot.validateCastOperand(operation, 0, evidence)
+        checked = true
+      }
+      morphhdl.MorphVerilog(config) {
+        dut = new OwnedResize(HdlInt.param("WIDTH", default = 5, min = 1, max = 8))
+        dut
+      }
+      val rtl = read(root.resolve("owned.v"))
+      assert(checked)
+      assert(port(rtl, "source").contains("wire signed [WIDTH-1:0]"))
+      assert(rtl.contains("source[(WIDTH)-1]"))
+      assert(!rtl.contains("source[4]"), "native witness sign bit escaped exact resize publication")
+    }
+  }
