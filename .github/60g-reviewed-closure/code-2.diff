+        val operation = dut.resized.head.source.asInstanceOf[ResizeSInt]
+        assert(ExternalParameterizedNativeResize.ownsSignedResize(operation))
+        snapshot.validateCastOperand(operation, 0, snapshot.castOperand(operation, 0))
+        operation.input = dut.foreign
