+      final class IndependentReductions(width: HdlInt, count: HdlInt) extends Component {
+        setDefinitionName("DefaultSignedIndependentReductions")
+        val data = in(Vec(SInt(width bits), count))
+        val sumValue = data.reduceBalancedTree((a: SInt, b: SInt) => a +^ b)
+        val minimumValue = data.reduceBalancedTree((a: SInt, b: SInt) => a.min(b))
+        val sum = out(cloneOf(sumValue))
+        val minimum = out(cloneOf(minimumValue))
+        sum := sumValue
+        minimum := minimumValue
+      }
+      import scala.sys.process._
+      val modes = Vector[(String, SpinalConfig => SpinalConfig)](
+        "default" -> ((config: SpinalConfig) => config),
+        "declarations" -> MorphSignedDeclarations.enable _,
+        "legacy" -> MorphSignedDeclarations.disable _)
+      for ((mode, select) <- modes) {
+        val file = root.resolve(s"independent-$mode.v")
+        morphhdl.MorphVerilog(select(fresh(file)))(new IndependentReductions(
