        "package morphhdl.ir.v1"
      ]
    },
    {
      "path": "morphir/src/main/scala/morphhdl/ir/v1/Model.scala",
      "required_markers": [
        "PostParameterizationPreEmission",
        "attributes: Vector[IrAttribute] = Vector.empty",
