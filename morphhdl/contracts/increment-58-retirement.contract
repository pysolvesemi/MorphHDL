  "required_files": [
    {
      "path": "morphhdl-passes/src/main/scala/morphhdl/passes/adapter/CanonicalIrPassAdapter.scala",
      "required_markers": [
        "bindValidatedInternal(handoff.validated)",
        "def bind(handoff: CanonicalIrHandoff): CanonicalIrPassView",
        "def bindFixture(",
        "handoff.profile.requiredFacets.subsetOf(handoff.completeFacets)"
      ]
    },
    {
      "path": "morphhdl/src/main/scala/morphhdl/MorphCanonicalIrReport.scala",
      "required_markers": [
        "final case class MorphCanonicalIrReport(",
