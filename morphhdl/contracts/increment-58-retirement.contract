        "phaseClassNames: Vector[String]"
      ]
    },
    {
      "path": "morphhdl/src/main/scala/morphhdl/MorphSingleSourceVerilogReport.scala",
      "required_markers": [
        "def elaborationParameters: Vector[ElaborationIntegerParameter]",
        "@transient private val serializedElaborationParameters: Vector[ElaborationIntegerParameter]"
      ]
    },
    {
      "path": "morphhdl/src/main/scala/morphhdl/MorphVerilog.scala",
      "required_markers": [
        "MorphHdlCanonicalIrProducer.install(capture)",
        "capture.handoff",
        "def generateWithCanonicalIr[T <: Component](",
        "def publishCanonicalIr[T <: Component](",
        "publisher.publish(report.handoff)",
        "val generated = generateSingleSource(isolated)(component)"
      ]
    },
    {
      "path": "morphhdl/src/main/scala/spinal/core/internals/MorphHdlCanonicalIrProducer.scala",
      "required_markers": [
        "CanonicalIrHandoff.create(design)",
        "capture.complete(snapshot.handoff)",
        "capture.retainPlan(retainedPlan)",
        "classOf[PhaseCheckCrossClock]",
        "classOf[PhaseInferWidth]",
        "classOf[PhaseNameNodesByReflection]",
        "expression.completedParameterRoots",
        "expression.exactDomain.exists",
        "new GraphSnapshotPhase(snapshot)",
        "phasePlan: () => Vector[String]",
        "retained.set(produce(top))",
        "root.isAuthoritativeSchema(direct)",
        "stage = CanonicalIrSchema.stage",
        "val boundary = crossClock.head + 1",
        "val later = phases.drop(boundary)",
        "_.isInstanceOf[PhaseAllocateNames]",
        "_.isInstanceOf[PhasePropagateNames]",
        "_.isInstanceOf[PhaseVerilog]"
      ]
    },
    {
      "path": "morphir/src/main/scala/morphhdl/ir/v1/Handoff.scala",
      "required_markers": [
        "CanonicalIrValidator.validate(design, maxErrors)",
        "def design: Design = validated.value",
        "def publish(handoff: CanonicalIrHandoff): Unit",
        "final class CanonicalIrHandoff private[v1] (",
        "fromValidated(validated, profile, completeFacets)",
        "trait CanonicalIrPublisher",
        "val completeFacets: Set[CanonicalIrFacet]",
        "val productionFacets: Set[CanonicalIrFacet]",
        "val productionProfile: CanonicalIrProfile",
        "val validated: ValidatedDesign"
      ]
    },
    {
      "path": "morphir/src/main/scala/morphhdl/ir/v1/Model.scala",
      "required_markers": [
        "val stage: IrStage = IrStage.PostParameterizationPreEmission"
      ]
    },
    {
      "path": "morphir/src/main/scala/morphhdl/ir/v1/Validation.scala",
      "required_markers": [
        "if (design.stage != CanonicalIrSchema.stage)",
        "Vector(\"design\", \"stage\")"
      ]
    }
  ],
  "forbidden_source_rules": [
    {
      "id": "frontend-parameterized-width-shadow-factory",
      "description": "Production frontend Bits, UInt and SInt compatibility aliases must delegate to native factories rather than ParameterizedWidth shadow factories.",
      "pattern": "\\bParameterizedWidth\\s*\\.\\s*(?:Bits|UInt|SInt)\\s*\\(",
      "self_test_source": "object Forbidden { val value = ParameterizedWidth.Bits(width) }",
      "path_prefixes": [
        "frontend/src/main/"
      ]
    },
    {
      "id": "producer-filesystem-access",
      "description": "The canonical producer must not read files or filesystem paths.",
      "pattern": "(?:\\b(?:Files|Paths)\\s*\\.|\\bjava\\.nio\\.file\\b|\\bjava\\.io\\b|\\bscala\\.io\\b)",
      "self_test_source": "val emitted = Files.readString(Paths.get(\"Top.v\"))",
      "path_prefixes": [
        "morphhdl/src/main/scala/spinal/core/internals/MorphHdlCanonicalIrProducer.scala"
      ]
    },
    {
      "id": "producer-generated-verilog-access",
      "description": "The canonical producer must not inspect generated Verilog or generated-source report paths.",
      "pattern": "(?:\\b(?:generatedSourcesPaths|rtlSourcesPaths|getRtlString|readGeneratedVerilog|parseGeneratedVerilog|scanGeneratedVerilog)\\b|\\b(?:emitted|generated|serialized)(?:Verilog|SystemVerilog|Hdl|Rtl)(?:Text|Source|Path|File)?\\b|\"[^\"\\n]*\\.(?:v|sv)\")",
      "self_test_source": "val emitted = report.generatedSourcesPaths.head",
      "path_prefixes": [
        "morphhdl/src/main/scala/spinal/core/internals/MorphHdlCanonicalIrProducer.scala"
      ]
    },
    {
      "id": "producer-name-semantic-inference",
      "description": "Names may be published as provenance, but may not select or identify semantic graph ownership.",
      "pattern": "(?:(?:getName\\s*\\([^)]*\\)|\\b(?:definitionName|instanceName|signalName|componentName|sourceFile)\\b)\\s*(?:==|!=|\\.contains\\s*\\(|\\.startsWith\\s*\\(|\\.endsWith\\s*\\(|\\.matches\\s*\\()|\\b(?:find|collectFirst|groupBy)\\s*\\([^\\n)]*(?:getName|definitionName|instanceName|signalName|componentName|sourceFile))",
      "self_test_source": "val owner = nodes.find(_.getName(\"\") == emittedName)",
      "path_prefixes": [
        "morphhdl/src/main/scala/spinal/core/internals/MorphHdlCanonicalIrProducer.scala"
      ]
    },
    {
      "id": "producer-regex-parsing",
      "description": "The canonical producer must not parse graph or HDL text with regular expressions.",
      "pattern": "(?:\\bscala\\.util\\.matching\\b|\\bjava\\.util\\.regex\\b|\\.r\\b|\\.regex\\b)",
      "self_test_source": "val declaration = \"wire (.*)\".r",
      "path_prefixes": [
        "morphhdl/src/main/scala/spinal/core/internals/MorphHdlCanonicalIrProducer.scala"
      ]
    },
    {
      "id": "producer-rendered-expression-inference",
      "description": "Typed parameter identity must come from roots and exact domains, never rendered expression text.",
      "pattern": "\\b(?:expression|condition)\\s*\\.\\s*(?:verilog|rendered)\\b",
      "self_test_source": "val key = expression.verilog",
      "path_prefixes": [
        "morphhdl/src/main/scala/spinal/core/internals/MorphHdlCanonicalIrProducer.scala"
      ]
    }
  ],
  "required_jar_class_entries": [
    "morphhdl/MorphCanonicalIrReport.class",
    "morphhdl/ir/v1/CanonicalIrHandoff.class",
    "morphhdl/ir/v1/CanonicalIrPublisher.class",
    "spinal/core/internals/MorphHdlCanonicalIrProducer$.class"
  ]
}
