name: Increment 53e clean generic closure v4

on:
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write
  actions: read
  checks: read

concurrency:
  group: increment-53e-clean-generic-closure
  cancel-in-progress: false

jobs:
  validate-publish-merge-audit:
    runs-on: ubuntu-latest
    container:
      image: ghcr.io/spinalhdl/docker:latest
    timeout-minutes: 360
    env:
      GH_TOKEN: ${{ github.token }}
      REPOSITORY: ${{ github.repository }}
      FEATURE: agent/increment-53e-generic-spinalhdl-proof
      TARGET: parameterized-verilog
    steps:
      - uses: actions/checkout@v4
        with:
          ref: agent/increment-53e-generic-spinalhdl-proof
          fetch-depth: 0

      - name: Prepare authenticated checkout
        shell: bash
        run: |
          set -euo pipefail
          git config --global --add safe.directory "$GITHUB_WORKSPACE"
          git config user.name github-actions[bot]
          git config user.email 41898282+github-actions[bot]@users.noreply.github.com

      - name: Reconcile the latest parameterized-verilog base
        shell: bash
        run: |
          set -euo pipefail
          git fetch origin "$TARGET"
          cp docs/morphhdl/parameterized-verilog-todo.md /tmp/feature-roadmap.md
          set +e
          git merge --no-commit --no-ff "origin/$TARGET"
          merge_status=$?
          set -e
          if test "$merge_status" -ne 0; then
            conflicts=$(git diff --name-only --diff-filter=U)
            allowed=docs/morphhdl/parameterized-verilog-todo.md
            if test "$conflicts" != "$allowed"; then
              echo 'Unexpected merge conflicts:' >&2
              printf '%s\n' "$conflicts" >&2
              exit 1
            fi
            git checkout --theirs -- "$allowed"
            python3 - <<'PY'
          from pathlib import Path
          path = Path('docs/morphhdl/parameterized-verilog-todo.md')
          value = path.read_text()
          opened = '- [ ] **Increment 53e — Native StreamFifoCC parameterization without source edits**'
          closed = '- [x] **Increment 53e — Native StreamFifoCC parameterization without source edits**'
          if closed in value:
              value = value.replace(closed, opened, 1)
          if opened not in value:
              raise SystemExit('Latest target roadmap has no Increment 53e contract')
          path.write_text(value)
          PY
            git add "$allowed"
          fi
          if ! git diff --cached --quiet; then
            git commit -m 'Merge latest parameterized-verilog into Increment 53e'
          fi
          git merge-base --is-ancestor "origin/$TARGET" HEAD

      - name: Apply generic graph and bounded-expression proofs
        shell: bash
        run: |
          set -euo pipefail
          required=(
            morphhdl/src/test/scala/morphhdl/NativeStreamFifoCCProofFixtures.scala
            morphhdl/src/test/scala/morphhdl/NativeStreamFifoCCImplementationProofTests.scala
            morphhdl/src/test/scala/morphhdl/NativeStreamFifoCCFormalEquivalenceTests.scala
            morphhdl/support/increment-53e/ExternalParameterizedDomainEquivalence.scala.template
            morphhdl/support/increment-53e/ExternalParameterizedDomainEquivalenceTests.scala.template
            morphhdl/support/increment-53e/morphhdl-native-streamfifocc-formal-equivalence.yml.template
            morphhdl/scripts/apply-increment-53e-generic-domain-proof-v2.py
          )
          for path in "${required[@]}"; do
            test -f "$path" || {
              echo "Missing required Increment 53e source: $path" >&2
              exit 1
            }
          done
          for script in \
            morphhdl/scripts/apply-increment-53e-address-role-repair.py \
            morphhdl/scripts/apply-increment-53e-implicit-child-width-formals.py \
            morphhdl/scripts/apply-increment-53e-canonical-implicit-formal-identity.py \
            morphhdl/scripts/apply-increment-53e-modular-literal-proof.py \
            morphhdl/scripts/apply-increment-53e-materialized-auto-resize-proof.py \
            morphhdl/scripts/apply-increment-53e-unfixed-literal-width-inference.py \
            morphhdl/scripts/apply-increment-53e-width-equivalence-proof.py \
            morphhdl/scripts/apply-increment-53e-generic-domain-proof.py \
            morphhdl/scripts/apply-increment-53e-generic-domain-proof-v2.py
          do
            if test -f "$script"; then python3 "$script"; fi
          done
          git diff --check

      - name: Enforce genericity and untouched native SpinalHDL production sources
        shell: bash
        run: |
          set -euo pipefail
          if ! git diff --quiet "origin/$TARGET" -- \
            core/src/main lib/src/main idslplugin/src/main; then
            echo 'Increment 53e modified native SpinalHDL production sources.' >&2
            git diff --stat "origin/$TARGET" -- \
              core/src/main lib/src/main idslplugin/src/main >&2
            exit 1
          fi
          generic=morphhdl/src/main/scala/spinal/core/internals/ExternalParameterizedDomainEquivalence.scala
          test -f "$generic"
          ! grep -E \
            'spinal\.lib|StreamFifo|StreamFifoCC|pushToPopGray|popToPushGray|Stream\.scala|CrossClock\.scala' \
            "$generic"
          grep -q 'MaximumAssignments' "$generic"
          grep -q 'provePositiveEquality' "$generic"
          grep -q 'evaluateRetainedExpression' "$generic"
          grep -q 'isProvenCompleteDomainWidthEquivalence' \
            morphhdl/src/main/scala/spinal/core/internals/ExternalParameterizedVerilogNativeFallback.scala
          grep -q 'evaluateDefinitionExpressionAtParameters' \
            morphruntime/src/main/scala/spinal/core/ExternalNativeIntShadowRegistry.scala
          grep -Fq 'spinal.lib.StreamFifoCC' \
            morphhdl/src/test/scala/morphhdl/NativeStreamFifoCCProofFixtures.scala
          ! grep -R -E \
            'class[[:space:]]+Morph.*StreamFifoCC|case class[[:space:]]+Morph.*StreamFifoCC' \
            frontend/src/main morphhdl/src/main morphruntime/src/main morphplugin/src/main

      - name: Install pinned build and verification tools
        shell: bash
        run: |
          set -euo pipefail
          curl --fail --location --retry 5 --retry-all-errors \
            https://repo.maven.apache.org/maven2/com/lihaoyi/mill-dist/1.1.0/mill-dist-1.1.0.exe \
            --output /tmp/morphhdl-mill
          chmod +x /tmp/morphhdl-mill
          apt-get update
          apt-get install -y --no-install-recommends git gh iverilog yosys z3 python3
          rm -rf /tmp/sby
          git clone --depth 1 https://github.com/YosysHQ/sby.git /tmp/sby
          ln -sf /tmp/sby/sbysrc/sby.py /usr/local/bin/sby
          chmod +x /tmp/sby/sbysrc/sby.py
          iverilog -V
          yosys -V
          z3 -version
          sby -h >/dev/null
          gh --version

      - name: Validate both supported Scala lanes before publication
        shell: bash
        run: |
          set -euo pipefail
          for lane in 2.12.18 2.13.12; do
            /tmp/morphhdl-mill "morph[$lane].testOnly" \
              spinal.core.internals.ExternalParameterizedDomainEquivalenceTests \
              morphhdl.ParameterizedStreamFifoCCTests \
              morphhdl.NativeStreamFifoCCImplementationProofTests \
              morphhdl.NativeStreamFifoCCFormalEquivalenceTests \
              morphhdl.NativeStreamFifoFormalEquivalenceTests \
              2>&1 | tee "/tmp/increment-53e-premerge-$lane.log"
          done

      - name: Prove independent native witnesses before publication
        shell: bash
        env:
          MORPHDL_RUN_STREAMFIFOCC_FORMAL_EQUIVALENCE: '1'
        run: |
          set -euo pipefail
          /tmp/morphhdl-mill 'morph[2.12.18].testOnly' \
            morphhdl.NativeStreamFifoCCFormalEquivalenceTests \
            2>&1 | tee /tmp/increment-53e-premerge-formal.log

      - name: Materialize the clean feature commit
        id: publish
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path
          roadmap = Path('docs/morphhdl/parameterized-verilog-todo.md')
          value = roadmap.read_text()
          old = '- [ ] **Increment 53e — Native StreamFifoCC parameterization without source edits**'
          new = '- [x] **Increment 53e — Native StreamFifoCC parameterization without source edits**'
          if old in value:
              value = value.replace(old, new, 1)
          elif new not in value:
              raise SystemExit('Increment 53e roadmap entry not found')
          roadmap.write_text(value)

          source = Path(
              'morphhdl/support/increment-53e/'
              'morphhdl-native-streamfifocc-formal-equivalence.yml.template'
          )
          target = Path(
              '.github/workflows/'
              'morphhdl-native-streamfifocc-formal-equivalence.yml'
          )
          target.write_text(source.read_text())
          PY
          rm -f .github/workflows/increment-53e-*.yml
          rm -rf morphhdl/support/increment-53e
          rm -f morphhdl/scripts/apply-increment-53e-*.py
          git add -A
          git diff --cached --check
          git commit -m 'Increment 53e: generic native StreamFifoCC parameterization'
          git push --force-with-lease origin HEAD:$FEATURE
          echo "sha=$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"

      - name: Open a pull request from the exact proven head
        id: pr
        shell: bash
        env:
          PUBLISHED_SHA: ${{ steps.publish.outputs.sha }}
        run: |
          set -euo pipefail
          number=$(gh pr list \
            --repo "$REPOSITORY" \
            --head "$FEATURE" \
            --base "$TARGET" \
            --state open \
            --json number,headRefOid \
            --jq '.[] | select(.headRefOid == env.PUBLISHED_SHA) | .number' \
            | head -1)
          if test -z "$number"; then
            gh pr create \
              --repo "$REPOSITORY" \
              --head "$FEATURE" \
              --base "$TARGET" \
              --title 'Increment 53e: generic native StreamFifoCC parameterization' \
              --body 'Uses the exact native spinal.lib.StreamFifoCC with untouched SpinalHDL production sources. Parameter handling is component-independent: complete bounded domains, retained expression semantics, and no FIFO/source/signal-name exceptions. Validation covers Scala 2.12/2.13, strict Verilog-2001 lint, Yosys synthesis, asynchronous independent-clock simulation, independent native witnesses, solver-backed equivalence, and a mutation counterexample.'
            number=$(gh pr list \
              --repo "$REPOSITORY" \
              --head "$FEATURE" \
              --base "$TARGET" \
              --state open \
              --json number \
              --jq '.[0].number')
          fi
          echo "number=$number" >> "$GITHUB_OUTPUT"

      - name: Squash merge the exact proven head
        shell: bash
        env:
          PR_NUMBER: ${{ steps.pr.outputs.number }}
          PUBLISHED_SHA: ${{ steps.publish.outputs.sha }}
        run: |
          set -euo pipefail
          actual=$(gh pr view "$PR_NUMBER" \
            --repo "$REPOSITORY" \
            --json headRefOid \
            --jq .headRefOid)
          test "$actual" = "$PUBLISHED_SHA"
          gh pr merge "$PR_NUMBER" \
            --repo "$REPOSITORY" \
            --squash \
            --delete-branch

      - name: Check out and structurally audit the exact merged target
        id: merged
        shell: bash
        run: |
          set -euo pipefail
          git fetch origin "$TARGET"
          target_sha=$(git rev-parse "origin/$TARGET")
          git checkout --detach "$target_sha"
          echo "sha=$target_sha" >> "$GITHUB_OUTPUT"
          grep -Fq -- \
            '- [x] **Increment 53e — Native StreamFifoCC parameterization without source edits**' \
            docs/morphhdl/parameterized-verilog-todo.md
          test -f \
            morphhdl/src/main/scala/spinal/core/internals/ExternalParameterizedDomainEquivalence.scala
          test -f \
            morphhdl/src/test/scala/spinal/core/internals/ExternalParameterizedDomainEquivalenceTests.scala
          test -f \
            morphhdl/src/test/scala/morphhdl/NativeStreamFifoCCImplementationProofTests.scala
          test -f \
            morphhdl/src/test/scala/morphhdl/NativeStreamFifoCCFormalEquivalenceTests.scala
          test -f \
            .github/workflows/morphhdl-native-streamfifocc-formal-equivalence.yml
          test -z "$(find .github/workflows morphhdl/scripts -maxdepth 1 \
            -type f -name 'increment-53e-*' -print -quit)"
          test ! -e morphhdl/support/increment-53e
          bash morphhdl/scripts/check-native-streamfifocc-parameterization-boundary.sh
          ! grep -E \
            'spinal\.lib|StreamFifo|StreamFifoCC|pushToPopGray|popToPushGray' \
            morphhdl/src/main/scala/spinal/core/internals/ExternalParameterizedDomainEquivalence.scala

      - name: Re-run both Scala lanes on the merged target
        shell: bash
        run: |
          set -euo pipefail
          for lane in 2.12.18 2.13.12; do
            /tmp/morphhdl-mill "morph[$lane].testOnly" \
              spinal.core.internals.ExternalParameterizedDomainEquivalenceTests \
              morphhdl.ParameterizedStreamFifoCCTests \
              morphhdl.NativeStreamFifoCCImplementationProofTests \
              morphhdl.NativeStreamFifoCCFormalEquivalenceTests \
              morphhdl.NativeStreamFifoFormalEquivalenceTests \
              2>&1 | tee "/tmp/increment-53e-postmerge-$lane.log"
          done

      - name: Re-prove independent native witnesses on the merged target
        shell: bash
        env:
          MORPHDL_RUN_STREAMFIFOCC_FORMAL_EQUIVALENCE: '1'
        run: |
          set -euo pipefail
          /tmp/morphhdl-mill 'morph[2.12.18].testOnly' \
            morphhdl.NativeStreamFifoCCFormalEquivalenceTests \
            2>&1 | tee /tmp/increment-53e-postmerge-formal.log

      - name: Upload complete pre-merge and post-merge evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: increment-53e-clean-generic-closure
          path: |
            /tmp/increment-53e-premerge-2.12.18.log
            /tmp/increment-53e-premerge-2.13.12.log
            /tmp/increment-53e-premerge-formal.log
            /tmp/increment-53e-postmerge-2.12.18.log
            /tmp/increment-53e-postmerge-2.13.12.log
            /tmp/increment-53e-postmerge-formal.log
          if-no-files-found: ignore
