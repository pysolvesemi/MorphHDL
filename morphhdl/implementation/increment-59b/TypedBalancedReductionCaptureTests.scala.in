package spinal.core.internals

import java.nio.file.Files
import morphhdl.frontend.HdlInt
import org.scalatest.funsuite.AnyFunSuite
import spinal.core._
import spinal.lib._

class TypedBalancedReductionCaptureTests extends AnyFunSuite {
  private def inspect(
      count: Int = 5,
      maximum: Int = 5,
      defaultWidth: Int = 5,
      pipeline: Boolean = false,
      useExplicitHelper: Boolean = false
  ): UnvalidatedBalancedReduction[UInt] = {
    var captured: UnvalidatedBalancedReduction[UInt] = null
    val directory = Files.createTempDirectory("morphhdl-reduction-capture-")
    SpinalConfig(targetDirectory = directory.toString, headerWithDate = false, headerWithRepoHash = false)
      .generateVerilog(new Component {
        val io = new Bundle {
          val packed = in Bits(defaultWidth * maximum bits)
          val result = out UInt(defaultWidth bits)
        }
        val width = HdlInt.param("WIDTH", defaultWidth, 1, 32)
        val size = HdlInt.param("COUNT", count, 1, maximum)
        val words = Vec(UInt(width bits), size)
        for (index <- 0 until maximum)
          words.vec(index) := io.packed(index * defaultWidth, defaultWidth bits).asUInt
        val handler = new ElabBalancedReduction.Backend {
          override def reduce[T <: Data](vector: Vec[T], op: (T, T) => T,
              bridge: (T, Int) => T, native: ElabBalancedReduction.Native[T]): T = {
            val record = TypedBalancedReductionCapture(vector, op, bridge, native)
            captured = record.asInstanceOf[UnvalidatedBalancedReduction[UInt]]
            record.result
          }
        }
        val op: (UInt, UInt) => UInt = (a, b) => a + b
        val bridge: (UInt, Int) => UInt = (value, _) =>
          if (pipeline) RegNext(value) init U(0, defaultWidth bits) else value
        val result = ElabBalancedReduction.withBackend(handler) {
          if (useExplicitHelper)
            new TraversableOncePimped[UInt](words).reduceBalancedTree(op, bridge)
          else words.reduceBalancedTree(op, bridge)
        }
        io.result := result.resized
      })
    assert(captured != null, "the ordinary Vec helper lost the exact typed receiver")
    captured
  }

  test("ordinary Vec syntax reaches the scoped native capture boundary") {
    val record = inspect()
    assert(record.shape.depth.verilog == "COUNT")
    assert(record.shape.elementLeaves.head.width.verilog == "WIDTH")
    assert(record.rows.count(_.operator.nonEmpty) == 4)
    assert(record.rows.map(_.level) == Vector(0, 0, 0, 1, 1, 2))
    assert(record.rows.map(_.index) == Vector(0, 1, 2, 0, 1, 0))
  }

  test("the explicit Data helper preserves the same native algorithm path") {
    val record = inspect(useExplicitHelper = true)
    assert(record.rows.count(_.operator.nonEmpty) == 4)
    assert(record.rows.size == 6)
  }

  test("singleton defaults retain native evidence needed by larger overrides") {
    val record = inspect(count = 1, maximum = 17)
    assert(record.shape.witnessDepth == 1)
    assert(record.plan.stages.size == 5)
    assert(record.rows.count(_.operator.nonEmpty) == 16)
    assert(record.shape.depth.default == 1)
  }

  test("a singleton-only domain preserves identity and never invokes a callback") {
    val record = inspect(count = 1, maximum = 1)
    assert(record.rows.isEmpty)
    assert(record.result eq record.vector.vec.head)
  }

  test("odd tails have no operator and preserve their exact bridge input") {
    val record = inspect()
    val tail0 = record.rows.find(row => row.level == 0 && row.index == 2).get
    val tail1 = record.rows.find(row => row.level == 1 && row.index == 1).get
    assert(tail0.operator.isEmpty && tail1.operator.isEmpty)
    assert(tail0.bridge.operands.head eq record.vector.vec(4))
    assert(tail1.bridge.operands.head eq tail0.bridge.result)
  }

  test("register level bridges are captured as native statements rather than reauthored RTL") {
    val record = inspect(pipeline = true)
    assert(record.rows.forall(_.bridge.declarations.exists(_.isReg)))
    assert(record.rows.forall(_.bridge.assignments.nonEmpty))
    assert(record.rows.count(_.operator.nonEmpty) == 4)
  }

  test("declaration identities remain distinct despite equal names and witnesses") {
    val a = inspect()
    val b = inspect()
    assert(a.vector ne b.vector)
    assert(a.shape.depth.parameters.head ne b.shape.depth.parameters.head)
    assert(a.shape.elementLeaves.head.width.parameters.head ne b.shape.elementLeaves.head.width.parameters.head)
    assert(a.rows.map(row => (row.level, row.index, row.operator.isDefined)) ==
      b.rows.map(row => (row.level, row.index, row.operator.isDefined)))
  }

  test("captured evidence cannot be promoted into a replay certificate") {
    val record = inspect()
    val error = intercept[IllegalArgumentException](record.requireReplayCertificate())
    assert(error.getMessage.contains("MORPH-REDUCE-BALANCED-REPLAY-UNVALIDATED"))
  }

  test("typed dispatch fails closed and scoped handlers are restored after exceptions") {
    var observed = false
    val directory = Files.createTempDirectory("morphhdl-reduction-scope-")
    SpinalConfig(targetDirectory = directory.toString).generateVerilog(new Component {
      val words = Vec(UInt(5 bits), HdlInt.param("COUNT", 3, 1, 3))
      words.vec.foreach(_ := 0)
      val handler = new ElabBalancedReduction.Backend {
        override def reduce[T <: Data](vector: Vec[T], op: (T, T) => T,
            bridge: (T, Int) => T, native: ElabBalancedReduction.Native[T]): T =
          throw new IllegalStateException("deliberate scoped failure")
      }
      try ElabBalancedReduction.withBackend(handler) { words.reduceBalancedTree(_ + _) }
      catch { case error: IllegalStateException =>
        assert(error.getMessage == "deliberate scoped failure")
      }
      try {
        words.reduceBalancedTree(_ + _)
        fail("a missing replay backend silently reduced the carrier")
      } catch { case error: IllegalArgumentException =>
        assert(error.getMessage.contains("SPINAL-ELAB-REDUCE-BALANCED-BACKEND-REQUIRED"))
        observed = true
      }
      val result = out UInt(5 bits)
      result := 0
    })
    assert(observed)
  }

  test("concrete reductions bypass the typed backend and keep concrete callback semantics") {
    var calls = 0
    val directory = Files.createTempDirectory("morphhdl-reduction-concrete-")
    SpinalConfig(targetDirectory = directory.toString).generateVerilog(new Component {
      val words = Vec(UInt(5 bits), 3)
      words.vec.foreach(_ := 0)
      val result = out UInt(5 bits)
      val handler = new ElabBalancedReduction.Backend {
        override def reduce[T <: Data](vector: Vec[T], op: (T, T) => T,
            bridge: (T, Int) => T, native: ElabBalancedReduction.Native[T]): T = {
          calls += 1
          throw new IllegalStateException("concrete call entered symbolic backend")
        }
      }
      result := ElabBalancedReduction.withBackend(handler) {
        words.reduceBalancedTree((a: UInt, b: UInt) => a - b)
      }
    })
    assert(calls == 0)
  }
}
