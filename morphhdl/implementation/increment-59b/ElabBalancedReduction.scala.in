package spinal.core

import scala.collection.{Seq, TraversableOnce}

/** Neutral, scoped dispatch for the existing native balanced-reduction helper.
  * It does not implement a reduction, infer an operator, or erase typed counts.
  */
object ElabBalancedReduction {
  private[spinal] type Native[T <: Data] =
    (Seq[T], (T, T) => T, (T, Int) => T) => T

  private[spinal] trait Backend {
    def reduce[T <: Data](
        vector: Vec[T],
        op: (T, T) => T,
        levelBridge: (T, Int) => T,
        native: Native[T]
    ): T
  }

  private val backend = ScopeProperty[Backend](null)

  /** The restoration must also run after rejected callbacks and nested scopes. */
  private[spinal] def withBackend[A](value: Backend)(body: => A): A = {
    require(value != null, "SPINAL-ELAB-REDUCE-BALANCED-BACKEND-NULL")
    val previous = backend.set(value)
    try body finally previous.restore()
  }

  /** A varying Vec must reach dispatch by exact receiver identity, not through
    * a collection conversion that could expose its finite native capacity.
    * All other inputs retain the historical toSeq conversion.
    */
  private[spinal] def sourceSeq[T <: Data](source: TraversableOnce[T]): Seq[T] =
    source match {
      case vector: Vec[_]
          if ParameterizedVec.shapeOf(vector).exists(_.depth.parameters.nonEmpty) =>
        vector.asInstanceOf[Vec[T]]
      case _ => source.toSeq
    }

  private[spinal] def reduce[T <: Data](
      source: Seq[T],
      op: (T, T) => T,
      levelBridge: (T, Int) => T
  )(native: Native[T]): T = source match {
    case vector: Vec[_]
        if ParameterizedVec.shapeOf(vector).exists(_.depth.parameters.nonEmpty) =>
      val selected = backend.get
      if (selected == null)
        throw new IllegalArgumentException(
          "SPINAL-ELAB-REDUCE-BALANCED-BACKEND-REQUIRED: " +
            "a symbolic Vec count requires validated balanced-stage replay; " +
            "it must not be converted to or reduced as a Scala collection"
        )
      selected.reduce(vector.asInstanceOf[Vec[T]], op, levelBridge, native)
    case _ => native(source, op, levelBridge)
  }
}
