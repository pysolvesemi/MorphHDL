        if entry["layer"] == "feature" and entry["mode"] == "100644"
    )
    with tempfile.TemporaryDirectory(prefix="morphhdl-wa08-overlay-") as directory:
        fixture = Path(directory) / "repo"
        subprocess.run(
            ["git", "clone", "--no-local", str(root), str(fixture)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            check=True,
            timeout=120,
        )
        subprocess.run(
            ["git", "-C", str(fixture), "fetch", str(root), "HEAD"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            check=True,
            timeout=120,
        )
        subprocess.run(
            ["git", "-C", str(fixture), "checkout", "--detach", "FETCH_HEAD"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            check=True,
        )

        def reset() -> None:
            subprocess.run(["git", "reset", "--hard", "HEAD"], cwd=fixture,
                           stdout=subprocess.DEVNULL, check=True)
            subprocess.run(["git", "clean", "-fd"], cwd=fixture,
                           stdout=subprocess.DEVNULL, check=True)

        def attack(label: str, mutate) -> None:
            nonlocal rejected
            reset()
            mutate()
            reject(fixture, label)
            rejected += 1

        attack(
            "changed bytes",
            lambda: (fixture / victim).write_bytes((fixture / victim).read_bytes() + b"\n"),
        )
        attack("missing file", lambda: (fixture / victim).unlink())
        attack("executable mode", lambda: os.chmod(fixture / victim, 0o755))

        def linked() -> None:
            (fixture / victim).unlink()
            (fixture / victim).symlink_to("/dev/null")

        attack("symlink", linked)

        def staged() -> None:
            (fixture / victim).write_bytes((fixture / victim).read_bytes() + b"\n")
            subprocess.run(["git", "add", victim], cwd=fixture, check=True)

        attack("staged mutation", staged)

        def unknown() -> None:
            path = fixture / "morphhdl/src/main/scala/morphhdl/UnknownWa08Overlay.scala"
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text("package morphhdl\n")

        attack("untracked source", unknown)
        attack(
            "contract tamper",
            lambda: (fixture / CONTRACT).write_bytes(
                (fixture / CONTRACT).read_bytes() + b" "
            ),
        )

        def profile() -> None:
            path = fixture / "morphir/src/main/scala/morphhdl/ir/v1/Handoff.scala"
            path.write_text(
                path.read_text().replace("PureWireExpressionsV1", "PureWireExpressionsV0", 1)
            )

        attack("profile mutation", profile)

    print(
        "INCREMENT_62_WA08_OVERLAY_PASS files=" + str(len(entries)) +
        " rejected=" + str(rejected)
    )


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--repo-root",
        type=Path,
        default=Path(__file__).resolve().parents[2],
    )
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    if args.self_test:
        self_test(args.repo_root)
    else:
        verify(args.repo_root)
        print("INCREMENT_62_WA08_OVERLAY_PASS")


if __name__ == "__main__":
    main()
'''
helper = (
    helper_template.replace("__BASE__", repr(BASE))
    .replace("__QUALIFIED__", repr(FEATURE))
    .replace("__CONTRACT__", repr(CONTRACT))
    .replace("__CONTRACT_SHA__", repr(contract_sha))
    .replace("__HELPER__", repr(HELPER))
)
write(HELPER, helper)

# Syntax checks precede the local source-only qualification.
run(
    "python3", "-m", "py_compile",
    HELPER, TEST, WA07B, ROLLOUT,
)
run("git", "diff", "--check")

# Commit locally so the overlay can bind HEAD/index/worktree to one exact tree.
run("git", "config", "user.name", "github-actions[bot]")
run("git", "config", "user.email", "41898282+github-actions[bot]@users.noreply.github.com")
run("git", "add", "-A")
run("git", "add", "-f", CONTRACT)
run("git", "diff", "--cached", "--check")
run("git", "commit", "-m", "Implement Increment 62 WA-08 source-audit compatibility")

# Execute the dedicated overlay and the exact inherited source gates that failed.
checks = [
    ["python3", HELPER],
    ["python3", HELPER, "--self-test"],
    ["python3", TEST],
    ["python3", "morphhdl/scripts/test-wa07b-inherited-review.py"],
    ["python3", "morphhdl/scripts/check-wa07b-inherited-review.py"],
    ["python3", "morphhdl/scripts/check-increment-60f-equivalence-closure.py", "--source-only"],
    ["python3", "morphhdl/scripts/check-increment-59c-source-review.py"],
    ["python3", "morphhdl/scripts/check-increment-59g-source-review.py"],
    ["python3", "morphhdl/scripts/check-increment-60g-source-scope.py"],
]
for command in checks:
    run(*command)
if git("status", "--porcelain").strip():
    raise RuntimeError("qualification changed the exact committed worktree")

run("git", "push", "origin", f"HEAD:{BRANCH}")
print("INCREMENT_62_PUBLISHED " + git("rev-parse", "HEAD").strip())
