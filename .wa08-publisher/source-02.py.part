                  python3 morphhdl/scripts/check-increment-60f-equivalence-closure.py --source-only
                  python3 morphhdl/scripts/check-increment-59c-source-review.py
                  python3 morphhdl/scripts/check-increment-59g-source-review.py
                  python3 morphhdl/scripts/check-increment-60g-source-scope.py
              - name: Require clean exact-head checkout
                shell: bash
                run: test -z "$(git status --porcelain)"
        '''
    ),
)

compatibility_paths = [WA07B, ROLLOUT, TEST, WORKFLOW]
records: list[dict] = []
for path in feature_paths:
    before = object_bytes(BASE, path)
    after = object_bytes(FEATURE, path)
    if after is None:
        raise RuntimeError("reviewed WA-08 feature path disappeared: " + path)
    tree = git("ls-tree", FEATURE, "--", path).split()
    if len(tree) < 3:
        raise RuntimeError("reviewed WA-08 tree entry missing: " + path)
    records.append(
        {
            "path": path,
            "layer": "feature",
            "baseline_commit": BASE,
            "change": "added" if before is None else "modified",
            "baseline_sha256": None if before is None else sha256(before),
            "final_sha256": sha256(after),
            "mode": tree[0],
            "production": re.search(r"(?:^|/)src/main/", path) is not None,
        }
    )
for path in compatibility_paths:
    before = object_bytes(FEATURE, path)
    after = (ROOT / path).read_bytes()
    records.append(
        {
            "path": path,
            "layer": "compatibility",
            "baseline_commit": FEATURE,
            "change": "added" if before is None else "modified",
            "baseline_sha256": None if before is None else sha256(before),
            "final_sha256": sha256(after),
            "mode": "100644",
            "production": re.search(r"(?:^|/)src/main/", path) is not None,
        }
    )
records.sort(key=lambda item: item["path"])
if len({item["path"] for item in records}) != len(records):
    raise RuntimeError("Increment 62 contract path inventory is duplicated")

contract_value = {
    "schema_version": 1,
    "base": BASE,
    "qualified_feature_commit": FEATURE,
    "files": records,
}
contract_raw = (json.dumps(contract_value, indent=2, sort_keys=True) + "\n").encode()
(ROOT / CONTRACT).parent.mkdir(parents=True, exist_ok=True)
(ROOT / CONTRACT).write_bytes(contract_raw)
os.chmod(ROOT / CONTRACT, 0o644)
contract_sha = sha256(contract_raw)

