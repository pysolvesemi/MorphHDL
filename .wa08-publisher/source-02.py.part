write(
    TEST,
    textwrap.dedent(
        '''\
        #!/usr/bin/env python3
        """Executable Increment 62 overlay attack regression."""
        from pathlib import Path
        import importlib.util

        ROOT = Path(__file__).resolve().parents[2]
        CHECKER = ROOT / "morphhdl/scripts/check-increment-62-wa08-source-overlay.py"
        spec = importlib.util.spec_from_file_location(
            "increment_62_wa08_overlay_test", CHECKER
        )
        if spec is None or spec.loader is None:
            raise RuntimeError("cannot load Increment 62 overlay checker")
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        module.self_test(ROOT)
        '''
    ),
    executable=False,
)

write(
    WORKFLOW,
    textwrap.dedent(
        '''\
        name: Increment 62 WA-08 inherited workflow closure

        on:
          pull_request:
            branches:
              - parameterized-verilog
          push:
            branches:
              - agent/wa-08-production-handoff

        permissions:
          contents: read

        concurrency:
          group: increment-62-wa08-${{ github.ref }}
          cancel-in-progress: true

        jobs:
          source-overlay:
            runs-on: ubuntu-24.04
            steps:
              - name: Check out exact WA-08 head
                uses: actions/checkout@v4
                with:
                  fetch-depth: 0
                  submodules: recursive
              - name: Verify exact overlay and attack controls
                shell: bash
                run: |
                  set -euo pipefail
                  python3 morphhdl/scripts/check-increment-62-wa08-source-overlay.py --self-test
                  python3 morphhdl/scripts/test-increment-62-wa08-source-overlay.py
                  python3 morphhdl/scripts/test-wa07b-inherited-review.py
                  python3 morphhdl/scripts/check-wa07b-inherited-review.py
              - name: Re-run inherited closed-source profiles
                shell: bash
                run: |
