# Increment 60g composes the same fully verified outer layer before enforcing
# its own exact historic source hashes and reversible spans.
rollout_file = ROOT / ROLLOUT
rollout_source = rollout_file.read_text(encoding="utf-8")
if "import functools\n" not in rollout_source:
    if rollout_source.count("import argparse\n") != 1:
        raise RuntimeError("60g import insertion marker missing or duplicated")
    rollout_source = rollout_source.replace(
        "import argparse\n", "import argparse\nimport functools\n", 1
    )
    rollout_file.write_text(rollout_source, encoding="utf-8")

