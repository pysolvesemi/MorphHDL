            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        require(inherited.returncode == 0,
                "required anchor is not an ancestor: " + anchor)

    records = {entry["path"]: entry for entry in value["files"]}
    paths = sorted(records)
    helper_raw = regular(root, HELPER_PATH)
    contract_raw = regular(root, CONTRACT)
    staged = index_entries(root, paths + [HELPER_PATH, CONTRACT])
    require(
        set(staged) == set(paths) | {HELPER_PATH, CONTRACT},
        "reviewed files are not uniquely tracked",
    )

    for path in paths:
        entry = records[path]
        raw = reviewed_bytes(root, path, entry["mode"])
        require(digest(raw) == entry["final_sha256"],
                "reviewed current bytes changed: " + path)
        before = object_bytes(root, entry["baseline_commit"], path)
        if entry["change"] == "added":
            require(before is None, "added path exists in frozen baseline: " + path)
        else:
            require(
                before is not None and digest(before) == entry["baseline_sha256"],
                "frozen baseline changed: " + path,
            )
        if entry["layer"] == "feature":
            frozen = object_bytes(root, QUALIFIED, path)
            require(
                frozen is not None and digest(frozen) == entry["final_sha256"],
                "feature differs from qualified checkpoint: " + path,
            )
        mode, blob, stage = staged[path]
        require(
            mode == entry["mode"] and stage == "0" and blob == oid(raw),
            "HEAD/index/worktree identity differs: " + path,
        )
        committed = git(root, "rev-parse", head + ":" + path).decode().strip()
        require(committed == blob, "current HEAD blob differs: " + path)

    for path, raw in ((HELPER_PATH, helper_raw), (CONTRACT, contract_raw)):
        mode, blob, stage = staged[path]
        committed = git(root, "rev-parse", head + ":" + path).decode().strip()
        require(
            mode == "100644" and stage == "0" and blob == oid(raw) and committed == blob,
            "helper/contract identity differs: " + path,
        )

    expected = set(paths) | {HELPER_PATH, CONTRACT}
    changed = {
        path.decode()
        for path in git(
            root, "diff", "--no-renames", "--name-only", "-z", BASE, head
        ).split(b"\0")
        if path
    }
    actual = {path for path in changed if governed(path)}
    require(
        actual == expected,
        "governed delta differs; missing=" + repr(sorted(expected - actual)) +
        "; unreviewed=" + repr(sorted(actual - expected)),
    )

    dirty: set[str] = set()
    for arguments in (
        ("diff", "--cached", "--name-only", "-z", head),
        ("diff", "--name-only", "-z"),
        ("ls-files", "--others", "--exclude-standard", "-z"),
    ):
        dirty |= {
            path.decode()
            for path in git(root, *arguments).split(b"\0")
            if path and governed(path.decode())
        }
    require(not dirty,
            "staged, unstaged or untracked governed content: " + repr(sorted(dirty)))

    handoff = regular(root, "morphir/src/main/scala/morphhdl/ir/v1/Handoff.scala").decode()
    adapter = regular(
        root,
        "morphhdl-passes/src/main/scala/morphhdl/passes/adapter/CanonicalIrPassAdapter.scala",
    ).decode()
    require(
        "case object PureWireExpressionsV1" in handoff
        and "case object PureExpressions" in handoff
        and "CanonicalIrProfile.PureWireExpressionsV1" in handoff,
        "production profile/facet claim is missing",
    )
    require(
        "handoff.profile == CanonicalIrHandoff.productionProfile" in adapter,
        "pass adapter does not require production profile",
    )
    return tuple(paths)


def verify(root: Path) -> bool:
    root = root.resolve()
    head = git(root, "rev-parse", "HEAD").decode().strip()
    _verify(str(root), head)
    return True


def records(root: Path) -> dict[str, dict]:
    verify(root)
    return {entry["path"]: entry for entry in load_contract(root)["files"]}


def restore_source(root: Path, path: str, source: bytes) -> bytes:
    entries = records(root)
    if path not in entries:
        return source
    entry = entries[path]
    before = object_bytes(root, entry["baseline_commit"], path) or b""
    if source == before:
        return source
    require(digest(source) == entry["final_sha256"],
            "cannot restore unknown bytes: " + path)
    return before


def inherited_inventory(root: Path, paths: set[str], revision: str) -> set[str]:
    entries = records(root)
    overlay = {path for path, entry in entries.items() if entry["production"]}
    previous = {
        path.decode()
        for path in git(
            root, "diff", "--no-renames", "--name-only", "-z", revision, BASE
        ).split(b"\0")
        if path
    }
    return (set(paths) - overlay) | (previous & overlay)


def reject(root: Path, label: str) -> None:
    result = subprocess.run(
        [sys.executable, HELPER_PATH, "--repo-root", str(root)],
        cwd=root,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
        timeout=120,
    )
    require(result.returncode != 0, "attack was accepted: " + label)


def self_test(root: Path) -> None:
    root = root.resolve()
    verify(root)
    entries = records(root)
    rejected = 0
    for path, entry in entries.items():
        raw = reviewed_bytes(root, path, entry["mode"])
        before = object_bytes(root, entry["baseline_commit"], path) or b""
        require(restore_source(root, path, raw) == before,
                "positive restoration failed: " + path)
        mutation = raw[:-1] + bytes([raw[-1] ^ 1]) if raw else b"x"
        try:
            restore_source(root, path, mutation)
        except RuntimeError:
            rejected += 1
        else:
            raise RuntimeError(
                "Increment 62 WA-08 overlay: mutated bytes restored: " + path
            )

    victim = next(
        path for path, entry in entries.items()
