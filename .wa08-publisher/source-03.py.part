import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

BASE = __BASE__
QUALIFIED = __QUALIFIED__
CONTRACT = __CONTRACT__
CONTRACT_SHA256 = __CONTRACT_SHA__
HELPER_PATH = __HELPER__


def require(ok: bool, detail: str) -> None:
    if not ok:
        raise RuntimeError("Increment 62 WA-08 overlay: " + detail)


def digest(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def git(root: Path, *args: str) -> bytes:
    result = subprocess.run(
        ["git", *args],
        cwd=root,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        timeout=120,
    )
    require(
        result.returncode == 0,
        "git command failed: " + " ".join(args) + "\n" +
        result.stderr.decode(errors="replace"),
    )
    return result.stdout


def governed(path: str) -> bool:
    return (
        re.search(r"(?:^|/)src/(?:main|test)/", path) is not None
        or path.startswith("morphhdl/scripts/")
        or path.startswith("morphhdl/contracts/")
        or path.startswith("morphhdl-passes/scripts/")
        or path.startswith("morphhdl-passes/tests/")
        or path.startswith(".github/workflows/")
    )


def regular(root: Path, relative: str) -> bytes:
    path = root / relative
    require(
        path.is_file()
        and not path.is_symlink()
        and stat.S_ISREG(path.stat().st_mode)
        and not path.stat().st_mode & 0o111,
        "missing, linked or executable reviewed file: " + relative,
    )
    rel = Path(relative)
    require(not rel.is_absolute() and ".." not in rel.parts,
            "invalid reviewed path: " + relative)
    require(
        all(
            not (root / Path(*rel.parts[:length])).is_symlink()
            for length in range(1, len(rel.parts))
        ),
        "reviewed file has a symlinked ancestor: " + relative,
    )
    return path.read_bytes()


def reviewed_bytes(root: Path, relative: str, mode: str) -> bytes:
    if mode == "100644":
        return regular(root, relative)
    if mode == "100755":
        path = root / relative
        require(
            path.is_file() and not path.is_symlink()
            and stat.S_ISREG(path.stat().st_mode)
            and bool(path.stat().st_mode & 0o111),
            "missing, linked or non-executable reviewed file: " + relative,
        )
        return path.read_bytes()
    require(mode == "120000", "unsupported reviewed mode: " + relative)
    path = root / relative
    require(path.is_symlink(), "reviewed symbolic link disappeared: " + relative)
    target_text = os.readlink(path)
    target = Path(target_text)
    require(not target.is_absolute(),
            "reviewed symbolic link uses an absolute target: " + relative)
    resolved = (path.parent / target).resolve()
    require(resolved.is_relative_to(root.resolve()) and resolved.is_file(),
            "reviewed symbolic link target is not one in-repository file: " + relative)
    return target_text.encode()


def object_bytes(root: Path, revision: str, path: str) -> bytes | None:
    exists = subprocess.run(
        ["git", "cat-file", "-e", revision + ":" + path],
        cwd=root,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return None if exists.returncode else git(root, "show", revision + ":" + path)


def oid(data: bytes) -> str:
    return hashlib.sha1(b"blob " + str(len(data)).encode() + b"\0" + data).hexdigest()


def load_contract(root: Path) -> dict:
    raw = regular(root, CONTRACT)
    require(digest(raw) == CONTRACT_SHA256, "compatibility contract changed")
    value = json.loads(raw)
    require(
        set(value) == {"schema_version", "base", "qualified_feature_commit", "files"},
        "invalid contract schema",
    )
    require(
        value["schema_version"] == 1
        and value["base"] == BASE
        and value["qualified_feature_commit"] == QUALIFIED,
        "contract anchors changed",
    )
    files = value["files"]
    paths = [entry.get("path") for entry in files]
    require(
        isinstance(files, list)
        and bool(files)
        and paths == sorted(paths)
        and len(set(paths)) == len(paths),
        "contract inventory is empty, duplicated or unsorted",
    )
    for entry in files:
        require(
            set(entry) == {
                "path", "layer", "baseline_commit", "change",
                "baseline_sha256", "final_sha256", "mode", "production",
            },
            "invalid contract record",
        )
        require(
            entry["layer"] in ("feature", "compatibility")
            and entry["change"] in ("added", "modified")
            and entry["mode"] in ("100644", "100755", "120000")
            and type(entry["production"]) is bool
            and re.fullmatch(r"[0-9a-f]{64}", entry["final_sha256"]) is not None,
            "invalid contract classification/hash: " + entry["path"],
        )
        require(
            (entry["baseline_sha256"] is None) == (entry["change"] == "added"),
            "baseline hash/change mismatch: " + entry["path"],
        )
        expected = BASE if entry["layer"] == "feature" else QUALIFIED
        require(entry["baseline_commit"] == expected,
                "wrong baseline layer: " + entry["path"])
    return value


def index_entries(root: Path, paths: list[str]) -> dict[str, tuple[str, str, str]]:
    result: dict[str, tuple[str, str, str]] = {}
    for record in git(root, "ls-files", "--stage", "-z", "--", *paths).split(b"\0"):
        if not record:
            continue
        metadata, name = record.split(b"\t", 1)
        mode, blob, stage = metadata.decode().split()
        path = name.decode()
        require(path not in result, "duplicate index entry: " + path)
        result[path] = (mode, blob, stage)
    return result


@functools.lru_cache(maxsize=8)
def _verify(root_text: str, head: str) -> tuple[str, ...]:
    root = Path(root_text)
    value = load_contract(root)
    for anchor in (BASE, QUALIFIED):
        inherited = subprocess.run(
            ["git", "merge-base", "--is-ancestor", anchor, head],
            cwd=root,
